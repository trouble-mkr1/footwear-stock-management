# Copy this file to .env and fill values locally.
DB_PORT = 5432
DB_NAME = footwear_inventory_new
DB_USER = postgres
DB_PASSWORD = replace_with_your_local_database_password

# Local: disable. Hosted PostgreSQL with verified TLS: require.
DB_SSL_MODE=disable

# Optional host-supplied CA certificate as Base64 (for private CA roots):
# DB_SSL_CA_BASE64=...
DB_POOL_MAX=10

# Generate an admin password hash using:
# node -e "require('bcryptjs').hash('YOUR_STRONG_PASSWORD', 12).then(console.log)"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=paste_bcrypt_hash_here

# Generate a random secret using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste_random_secret_here

# Only set NODE_ENV=production when served securely over HTTPS.
NODE_ENV=development
PORT=3000

# Hosting with a persistent disk ONLY: directory must survive restarts/redeploys.
# For local development, leave unset to use public/images.
# IMAGE_UPLOAD_DIR=./storage/images

# Optional for manually enabled integration tests ONLY:
# TEST_DB_NAME = footwear_inventory_test

# Optional business contact number displayed by Contact Us on customer dashboard:
# BUSINESS_CONTACT_PHONE = +91XXXXXXXXXX