# Copy this file to .env and fill values locally. NEVER commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=footwear_inventory_new
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_database_password

# Generate an admin password hash using:
# node -e "require('bcryptjs').hash('YOUR_STRONG_PASSWORD', 12).then(console.log)"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=paste_bcrypt_hash_here

# Generate a random secret using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste_random_secret_here

# Only set NODE_ENV=production when served securely over HTTPS.
NODE_ENV=development
PORT=3000

# Optional for manually enabled integration tests ONLY:
# TEST_DB_NAME=footwear_inventory_test
